<button onclick="voltarParaModulos()" 
        class="group mb-8 flex items-center gap-3 px-5 py-2.5 bg-white border border-slate-200 text-slate-500 rounded-2xl hover:bg-blue-50 hover:text-blue-600 hover:border-blue-100 transition-all duration-300 shadow-sm active:scale-95">
    <i class="fas fa-arrow-left text-xs group-hover:-translate-x-1 transition-transform"></i>
    <span class="text-[11px] font-black uppercase tracking-widest text-slate-600">Voltar para Módulos</span>
</button>

<div class="p-6 fade-in">
  <div class="flex flex-col md:flex-row justify-between items-end gap-4 mb-8">
    <div class="w-full md:w-auto">
      <h2 class="text-3xl font-black text-slate-800 tracking-tighter uppercase leading-none">Prospecção TIM</h2>
      <p class="text-slate-500 text-sm font-medium mt-2 italic text-slate-400">
        Pendentes: <span id="contagemLeads" class="text-blue-600 font-bold px-3 py-1 bg-blue-50 rounded-full text-xs shadow-sm">0</span> na base total
      </p>
    </div>

    <div class="relative w-full md:w-72">
      <label class="text-[9px] font-black uppercase text-slate-400 ml-2 mb-1 block tracking-widest">Filtrar por Consultor</label>
      <div class="relative">
        <select id="filtroVendedor" onchange="filtrarPorVendedor()" 
                class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3 text-xs font-black text-slate-700 focus:ring-2 focus:ring-blue-500 appearance-none transition-all uppercase cursor-pointer shadow-sm">
          <option value="">TODOS OS CONSULTORES</option>
        </select>
        <i class="fas fa-chevron-down absolute right-4 top-4 text-slate-400 pointer-events-none text-[10px]"></i>
      </div>
    </div>

    <button onclick="carregarProspecTIM()" class="bg-blue-600 text-white px-6 py-3 rounded-2xl text-[10px] font-black hover:bg-blue-700 transition-all shadow-lg hover:shadow-blue-500/30 uppercase flex items-center gap-2 h-fit">
      <i class="fas fa-sync"></i> Atualizar Base
    </button>
  </div>

  <div class="bg-white rounded-[32px] border border-slate-200 shadow-2xl shadow-slate-200/50 overflow-hidden text-slate-600">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse" id="tabelaMestra">
        <thead>
          <tr class="bg-slate-50/80 border-b border-slate-100">
            <th class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-center">Data</th>
            <th class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest">Cliente</th>
            <th class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest">Modalidade/Plano</th>
            <th class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-center">CPF</th>
            <th class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-center">Consultor Venda</th>
            <th class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-center">Telefone</th>
            <th class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-center bg-slate-100/50">Ação</th>
          </tr>
        </thead>
        <tbody id="listaProspecTIM" class="divide-y divide-slate-100"></tbody>
      </table>
    </div>
  </div>
</div>

<style>
  /* Efeito de Zebrar as linhas: Linhas pares com fundo levemente acinzentado */
  #listaProspecTIM tr:nth-child(even) {
    background-color: #fcfdfe;
  }

  /* Efeito Hover: Destaca a linha inteira ao passar o mouse */
  #listaProspecTIM tr:hover {
    background-color: #f1f5f9 !important;
    transition: background-color 0.2s ease;
  }
</style>

<script>
/**
 * Alimenta o Select com nomes únicos presentes na base carregada
 */
function gerarFiltroConsultores(leads) {
  const select = document.getElementById("filtroVendedor");
  const valorSelecionado = select.value;
  const nomes = [...new Set(leads.map(l => l.vendedor).filter(v => v))].sort();
  
  select.innerHTML = '<option value="">TODOS OS CONSULTORES</option>';
  nomes.forEach(nome => {
    const opt = document.createElement("option");
    opt.value = nome.toUpperCase();
    opt.textContent = nome.toUpperCase();
    select.appendChild(opt);
  });

  if (nomes.includes(valorSelecionado)) {
    select.value = valorSelecionado;
  }
}

/**
 * Filtra as linhas visíveis na tabela
 */
function filtrarPorVendedor() {
  const select = document.getElementById("filtroVendedor");
  const filter = select.value.toUpperCase();
  const tbody = document.getElementById("listaProspecTIM");
  const tr = tbody.getElementsByTagName("tr");
  let visiveis = 0;

  for (let i = 0; i < tr.length; i++) {
    const tdVendedor = tr[i].getElementsByTagName("td")[4]; 
    if (tdVendedor) {
      const txtValue = tdVendedor.textContent || tdVendedor.innerText;
      if (filter === "" || txtValue.toUpperCase().trim() === filter) {
        tr[i].style.display = "";
        visiveis++;
      } else {
        tr[i].style.display = "none";
      }
    }
  }
  document.getElementById("contagemLeads").innerText = visiveis;
}

function inicializarProspecTIM() { carregarProspecTIM(); }

function carregarProspecTIM() {
  const tbody = document.getElementById("listaProspecTIM");
  const contador = document.getElementById("contagemLeads");
  
  tbody.innerHTML = '<tr><td colspan="7" class="py-24 text-center text-slate-400 font-black animate-pulse uppercase text-xs tracking-widest">Escaneando base total...</td></tr>';

  google.script.run
    .withSuccessHandler(function(res) {
      tbody.innerHTML = "";
      if (!res.leads || res.leads.length === 0) {
        contador.innerText = "0";
        tbody.innerHTML = '<tr><td colspan="7" class="py-24 text-center text-emerald-500 font-black uppercase text-xs">Base limpa! 🎉</td></tr>';
        return;
      }
      
      gerarFiltroConsultores(res.leads);

      res.leads.forEach(lead => {
        const tr = document.createElement("tr");
        const corFase = lead.fase === "APARELHO" ? "text-blue-600 bg-blue-50 border-blue-100" : "text-indigo-600 bg-indigo-50 border-indigo-100";
        
        tr.innerHTML = `
          <td class="px-6 py-4 text-center font-bold text-[11px] text-slate-400 leading-tight">${lead.dataCompra}</td>
          <td class="px-6 py-4">
            <div class="flex flex-col">
              <span class="font-black text-slate-800 uppercase text-sm tracking-tighter leading-none">${lead.nome}</span>
              <span class="text-[9px] font-black px-2 py-0.5 rounded border uppercase mt-1.5 w-fit shadow-sm ${corFase}">${lead.oferta}</span>
            </div>
          </td>
          <td class="px-6 py-4">
            <div class="flex flex-col justify-center">
              <span class="text-[9px] font-bold text-slate-400 uppercase leading-none mb-1 tracking-tight">${lead.modalidade}</span>
              <span class="text-[10px] font-black text-slate-700 uppercase tracking-tighter">${lead.plano}</span>
            </div>
          </td>
          <td class="px-6 py-4 text-center font-mono text-[11px] text-slate-400 font-medium">${lead.cpf}</td>
          <td class="px-6 py-4 text-center">
            <span class="text-[10px] font-black text-slate-600 bg-white px-3 py-1.5 rounded-xl uppercase tracking-tighter border border-slate-200 shadow-sm">
              ${lead.vendedor}
            </span>
          </td>
          <td class="px-6 py-4 text-center font-black text-xs text-slate-700 tracking-tighter">${lead.telefone}</td>
          <td class="px-6 py-4 text-center bg-slate-50/30">
            <button onclick="abordarTIM('${lead.nome}', '${lead.telefone}', '${lead.fase}', '${lead.aba}', ${lead.linha}, this)" 
                    class="bg-green-500 text-white px-5 py-2.5 rounded-2xl text-[10px] font-black hover:bg-green-600 transition-all shadow-lg hover:shadow-green-500/30 active:scale-95 uppercase flex items-center justify-center gap-2 mx-auto group/btn">
              <i class="fab fa-whatsapp group-hover/btn:scale-125 transition-transform"></i> Interagir
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      contador.innerText = res.leads.length;
      filtrarPorVendedor();
    })
    .getProspeccaoTIMData();
}

function abordarTIM(nome, tel, fase, aba, linha, botao) {
  const row = botao.closest('tr');
  
  // Tratamento do nome do Atendente (Primeira letra maiúscula)
  let atendenteMsg = "Consultor TIM"; // Fallback elegante
  if (typeof loggedUser !== 'undefined' && loggedUser) {
    const nomePuro = loggedUser.trim().split(" ")[0].toLowerCase();
    atendenteMsg = nomePuro.charAt(0).toUpperCase() + nomePuro.slice(1);
  }

  const primeiroNomeCliente = nome.split(' ')[0];

  // --- MENSAGEM PARA APARELHO (50 DIAS) ---
  const msgAparelho = `Olá, ${primeiroNomeCliente}! ✨\n\n` +
                      `Aqui quem fala é ${atendenteMsg}. Tudo bem? 👋\n\n` +
                      `Estou passando para te dar uma notícia excelente! Completamos *50 dias* da sua adesão de sua promoção junto a TIM e o sistema acaba de liberar uma *OFERTA EXCLUSIVA* para você trocar seu aparelho! 📱🚀\n\n` +
                      `Preparamos condições especiais para seu contrato conosco. Vou te enviar abaixo uma oferta especial que separei para você! 👇`;

  // --- MENSAGEM PARA ACESSÓRIO (120 DIAS) ---
  const msgAcessorio = `Oi, ${primeiroNomeCliente}! Tudo certo? ✨\n\n` +
                       `Aqui quem fala é ${atendenteMsg}. Passando para agradecer sua parceria conosco! 🤝\n\n` +
                       `Hoje você entrou para nossa lista de clientes VIP e liberamos algumas promoções em acessórios! 🎧🔥\n\n` +
                       `Vou te enviar abaixo uma oferta promocional especial que separei para te mostrar...`;

  // Abre o WhatsApp
  window.open(`https://api.whatsapp.com/send?phone=55${tel.replace(/\D/g, '')}&text=${encodeURIComponent(fase === "APARELHO" ? msgAparelho : msgAcessorio)}`, '_blank');

  // --- ANIMAÇÃO E REMOÇÃO DA LINHA ---
  row.style.transition = 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
  row.style.transform = 'translateX(80px)';
  row.style.opacity = '0';
  
  setTimeout(() => {
    row.remove();
    const contador = document.getElementById("contagemLeads");
    if (contador) {
        const total = parseInt(contador.innerText);
        contador.innerText = total > 0 ? total - 1 : 0;
    }
    
    const tbody = document.getElementById("listaProspecTIM");
    if (tbody && tbody.children.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="py-24 text-center text-emerald-500 font-black uppercase text-xs tracking-widest">Tudo em dia! 🎉</td></tr>';
    }
  }, 600);

  // Registro no Google Sheets (Usa o nome completo para o log da planilha)
  google.script.run.registrarContatoTIM(aba, linha, fase, typeof loggedUser !== 'undefined' ? loggedUser : "Sistema");
}
</script>
